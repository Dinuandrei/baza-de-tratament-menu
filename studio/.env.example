# Studio environment — used by the “Previzualizează pe site” document action.
# Copy to .env.local (or set these in the Sanity-hosted Studio).
#
# Opens: $SANITY_STUDIO_PREVIEW_URL/api/preview?secret=$SANITY_STUDIO_PREVIEW_SECRET&lang=ro
# The secret must equal SANITY_PREVIEW_SECRET in the app's Vercel environment.
# It only enables reading drafts (the Sanity read token stays server-side).
SANITY_STUDIO_PREVIEW_URL=https://baza-de-tratament.vercel.app
SANITY_STUDIO_PREVIEW_SECRET=
