# Public dataset — the menu is public content, so no token is required.
# These two are also the built-in defaults in src/lib/sanity.ts.
NEXT_PUBLIC_SANITY_PROJECT_ID=w6d4ck0i
NEXT_PUBLIC_SANITY_DATASET=production

# Only needed if the dataset is ever switched back to private.
# SANITY_API_READ_TOKEN=

# Azure AI Translator — used by the translation backfill and the publish webhook.
# Create a "Translator" resource (Free F0 = 2M chars/month), then copy KEY 1 and
# the region from "Keys and Endpoint". Keep the key out of git (.env.local).
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=westeurope
# Optional, only for a regional endpoint:
# AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# Gemini (Google AI Studio) — alternative to Azure. When AZURE_TRANSLATOR_KEY is
# empty the webhook and the backfill use this key instead.
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Required by the publish webhook (POST /api/translate-product) and by the
# on-demand revalidation webhook (POST /api/revalidate).
# Write token: Sanity → API → Tokens, role Editor.
SANITY_WRITE_TOKEN=
# Shared secret sent by Sanity in the x-webhook-secret header.
TRANSLATE_WEBHOOK_SECRET=
# Only during a secret rotation: the old value stays valid until you remove it.
# TRANSLATE_WEBHOOK_SECRET_PREVIOUS=

# Draft preview (GET /api/preview?secret=…&lang=ro). Needs a Viewer token so the
# app can read unpublished drafts while previewing.
SANITY_PREVIEW_SECRET=
# SANITY_API_READ_TOKEN=   (Viewer token, only used in preview mode)

# Studio side (studio/.env): the “Previzualizează” document action opens
#   $SANITY_STUDIO_PREVIEW_URL/api/preview?secret=$SANITY_STUDIO_PREVIEW_SECRET&lang=ro
# SANITY_STUDIO_PREVIEW_URL=https://baza-de-tratament.vercel.app
# SANITY_STUDIO_PREVIEW_SECRET=<same value as SANITY_PREVIEW_SECRET>
